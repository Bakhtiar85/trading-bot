# --- Binance -------------------------------------------------------------------
# The key needs ONLY "Enable Reading" + "Enable Spot & Margin Trading".
# NEVER enable withdrawals. On mainnet the bot checks this and refuses to start if they are enabled.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = Binance Spot Testnet (fake money, keys from https://testnet.binance.vision). Keep true until you've tested.
BINANCE_USE_TESTNET=true

# --- Grid ----------------------------------------------------------------------
# Must be a USDT-quoted pair.
TRADING_PAIR=BTCUSDT
GRID_LOWER_BOUND=
GRID_UPPER_BOUND=
# Number of price lines (inclusive of both bounds). 10 lines = 9 buy/sell slots.
GRID_LEVELS=10
# USDT the bot may use. Must be available as free USDT when a new session starts.
CAPITAL_ALLOCATION_USDT=

# --- Safety (hard-coded rules, no AI) --------------------------------------------
# Sell everything and STOP if the bot's holdings fall this % below CAPITAL_ALLOCATION_USDT.
STOP_LOSS_PERCENT=15
# true  = if price leaves [lower, upper]: cancel grid orders and PAUSE (recommended).
# false = alert-only: email once, leave orders in place. Stop-loss stays active either way.
BREAKOUT_PAUSE=true
CHECK_INTERVAL_SECONDS=60

# --- Notifications -----------------------------------------------------------------
# Optional. Used ONLY to write plain-English incident summaries. Never makes trading decisions.
ANTHROPIC_API_KEY=
# Optional as a group: leave all blank to only log emails. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
# Hours between "still running" emails.
HEARTBEAT_INTERVAL_HOURS=24

# --- Misc ----------------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# Optional overrides (default ./data and ./logs relative to the working directory).
# On Render etc., DATA_DIR MUST be on a persistent disk or the PAUSED/STOPPED state is lost on restart.
# DATA_DIR=
# LOG_DIR=
